{
  "manifest_version": 3,
  "name": "TISAP Security Simulator",
  "version": "0.1.0",
  "description": "Simulate browser security events to TISAP FastAPI backend.",
  "action": {
    "default_title": "TISAP Security Simulator",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
